# Project
COMPOSE_PROJECT_NAME=automation

# PostgreSQL
POSTGRES_IMAGE_TAG=16-alpine
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PGDATA=/var/lib/postgresql/data/pgdata

# Backup policy
BACKUP_RETENTION_DAYS=14

# n8n
N8N_IMAGE=n8nio/n8n:latest
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.example.com/
WEBHOOK_URL=https://n8n.example.com/
N8N_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
N8N_DIAGNOSTICS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_METRICS=true
N8N_LOG_LEVEL=info
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
N8N_EXECUTIONS_DATA_PRUNE=true
N8N_EXECUTIONS_DATA_MAX_AGE=336
GENERIC_TIMEZONE=UTC
TZ=UTC

# Caddy
CADDY_IMAGE_TAG=2-alpine
CADDY_ACME_EMAIL=ops@example.com
CADDY_ADMIN=off

# Uptime Kuma
UPTIME_KUMA_IMAGE_TAG=1
UPTIME_KUMA_HOST=status.example.com
